# demo: offline, labeled sample layouts only. openai: arbitrary invoices and receipts.
DOCINTEL_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_UPLOAD_MB=10
MAX_PAGES=10
MAX_TEXT_CHARS=60000
MAX_RECHECKS=1
OCR_LANGUAGE=eng
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# demo: offline, labeled sample layouts only. gemini: arbitrary invoices and receipts.
DOCINTEL_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Local persistent uploads and reports. Docker Compose overrides this to /data.
DOCINTEL_DATA_DIR=data
MAX_UPLOAD_MB=10
MAX_PAGES=10
MAX_TEXT_CHARS=60000
MAX_RECHECKS=1
OCR_LANGUAGE=eng
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
